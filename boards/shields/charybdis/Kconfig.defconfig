if SHIELD_CHARYBDIS_RIGHT_STANDALONE || SHIELD_CHARYBDIS_RIGHT_STANDALONE_RGB

config ZMK_KEYBOARD_NAME
	default "Charybdis"

config ZMK_SPLIT_BLE_ROLE_CENTRAL
	default y

endif

if SHIELD_DONGLE_CHARYBDIS_RIGHT || SHIELD_DONGLE_CHARYBDIS_RIGHT_RGB

config ZMK_KEYBOARD_NAME
	default "Charybdis Right"

endif

if SHIELD_DONGLE_PROSPECTOR || SHIELD_DONGLE_BWSHOCKLEY_PROSPECTOR

config ZMK_KEYBOARD_NAME
	default "Charybdis"

config ZMK_SPLIT_BLE_ROLE_CENTRAL
	default y

endif

if SHIELD_DONGLE_ZDSE_PROSPECTOR

config ZMK_KEYBOARD_NAME
	default "Charybdis"

config ZMK_SPLIT_BLE_ROLE_CENTRAL
	default y

# ST7789V pixel format and backlight dependencies previously provided by
# carrefinho's prospector_adapter shield
choice ST7789V_PIXEL_FORMAT
	default ST7789V_RGB565
endchoice

config PWM
	default y

config LED
	default y

endif

if SHIELD_DONGLE_NICE || SHIELD_DONGLE_NICE_ROUND

config ZMK_KEYBOARD_NAME
	default "Charybdis"

config ZMK_SPLIT_BLE_ROLE_CENTRAL
	default y

endif

if SHIELD_CHARYBDIS_LEFT_RGB || SHIELD_CHARYBDIS_RIGHT_STANDALONE_RGB || SHIELD_DONGLE_CHARYBDIS_RIGHT_RGB

config SPI
	default y

config LED_STRIP
	default y

config ZMK_RGB_UNDERGLOW
	default y

endif

if SHIELD_CHARYBDIS_LEFT || SHIELD_CHARYBDIS_LEFT_RGB || SHIELD_CHARYBDIS_RIGHT_STANDALONE || SHIELD_CHARYBDIS_RIGHT_STANDALONE_RGB || SHIELD_DONGLE_CHARYBDIS_RIGHT || SHIELD_DONGLE_CHARYBDIS_RIGHT_RGB || SHIELD_DONGLE_PROSPECTOR || SHIELD_DONGLE_NICE || SHIELD_DONGLE_BWSHOCKLEY_PROSPECTOR || SHIELD_DONGLE_ZDSE_PROSPECTOR || SHIELD_DONGLE_NICE_ROUND

config ZMK_SPLIT
	default y

endif
